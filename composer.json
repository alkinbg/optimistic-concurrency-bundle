{
    "name": "alkinbg/optimistic-concurrency-bundle",
    "type": "symfony-bundle",
    "description": "HTTP optimistic concurrency control for Symfony and Doctrine using strong ETags, If-Match, and ORM versioning.",
    "keywords": [
        "symfony",
        "doctrine",
        "optimistic-concurrency",
        "optimistic-locking",
        "concurrency",
        "etag",
        "if-match",
        "http",
        "lost-update"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Alkin Fehim"
        }
    ],
    "support": {
        "issues": "https://github.com/alkinbg/optimistic-concurrency-bundle/issues",
        "source": "https://github.com/alkinbg/optimistic-concurrency-bundle"
    },
    "require": {
        "php": "^8.2",
        "doctrine/doctrine-bundle": "^2.19 || ^3.3",
        "doctrine/orm": "^3.4.4",
        "doctrine/persistence": "^3.3 || ^4.0",
        "symfony/config": "^7.4 || ^8.1",
        "symfony/dependency-injection": "^7.4 || ^8.1",
        "symfony/event-dispatcher": "^7.4 || ^8.1",
        "symfony/http-foundation": "^7.4 || ^8.1",
        "symfony/http-kernel": "^7.4 || ^8.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.90",
        "phpstan/phpstan": "^2.2.2",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpunit/phpunit": "^11.5 || ^12.5",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "symfony/browser-kit": "^7.4 || ^8.1",
        "symfony/framework-bundle": "^7.4 || ^8.1",
        "symfony/routing": "^7.4 || ^8.1",
        "symfony/runtime": "^7.4 || ^8.1",
        "symfony/security-bundle": "^7.4 || ^8.1"
    },
    "autoload": {
        "psr-4": {
            "OptimisticConcurrency\\Bundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OptimisticConcurrency\\Bundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "validate:composer": "composer validate --strict",
        "check:platform": "composer check-platform-reqs",
        "security:audit": "composer audit --locked",
        "format": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "format:check": "php-cs-fixer check --diff --config=.php-cs-fixer.dist.php",
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "qa": [
            "@validate:composer",
            "@check:platform",
            "@security:audit",
            "@format:check",
            "@test",
            "@analyse"
        ]
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true
    }
}
